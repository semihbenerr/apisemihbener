<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Plugin projesi: host'a panelden zip olarak yüklenir.
    EnableDynamicLoading: bağımlılıkları çıktıya kopyalar (dinamik yükleme için gerekli).
    GenerateRuntimeConfigurationFiles: "dotnet ef" komutlarının bu projeyi startup olarak kullanabilmesi için.
  -->
  <PropertyGroup>
    <RootNamespace>SemihBener.Plugin.Football</RootNamespace>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <GenerateRuntimeConfigurationFiles>true</GenerateRuntimeConfigurationFiles>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\SemihBener.Abstractions\SemihBener.Abstractions.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="$(EfCoreVersion)">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <None Update="plugin.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
