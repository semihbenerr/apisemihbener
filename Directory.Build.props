<Project>
  <!--
    Tüm projeler için ortak ayarlar ve paket sürümleri.
    Tüm plugin'ler MSSQL kullanır; EF Core 10'da olduğumuz için Pomelo (MySQL) yok.
    Tüm EF Core paketleri aynı ana sürümde (10.0.x) olmak zorunda.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <Version>1.0.0</Version>

    <EfCoreVersion>10.0.*</EfCoreVersion>
    <AspNetCoreVersion>10.0.*</AspNetCoreVersion>
    <SwaggerUiVersion>9.*</SwaggerUiVersion>
  </PropertyGroup>
</Project>
